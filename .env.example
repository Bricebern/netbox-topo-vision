# ─────────────────────────────────────────────────────────────
# NetBox Topo Vision — environment configuration
# Copy this file to ".env" and adjust the values.
# ─────────────────────────────────────────────────────────────

# Full URL of your NetBox instance (no trailing slash).
#
# ⚠️  DO NOT use http://localhost:8000
#     Inside Docker, localhost refers to the container itself, not your machine.
#     Use your machine's LAN IP instead.
#
# Find your LAN IP:
#   Linux/macOS : hostname -I | awk '{print $1}'
#   Windows     : ipconfig  (look for IPv4 Address)
#
# Examples:
#   NETBOX_URL=http://192.168.1.100:8000   ← LAN IP (recommended)
#   NETBOX_URL=http://host.docker.internal:8000  ← alternative on Linux with extra_hosts
#   NETBOX_URL=https://netbox.example.com  ← remote/production instance
NETBOX_URL=http://192.168.1.100:8000

# NetBox API token (read-only is sufficient).
# Create one in NetBox: Admin → API Tokens → Add Token
NETBOX_TOKEN=your_token_here

# Host port that exposes the topo-vision web UI.
# Access the app at http://localhost:${APP_PORT}
APP_PORT=8090
